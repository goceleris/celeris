{
  "version": 1,
  "driver": "redis",
  "regenerate": "go test -tags redis -run '^TestSupportTable$' ./test/conformance/redis/",
  "sections": [
    {
      "id": "reply-types",
      "title": "Reply types",
      "rows": [
        {
          "id": "simple-string",
          "label": "Simple string (+OK)",
          "returns": "`Value.Type` is `TySimple`, the payload is in `Value.Str`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "integer",
          "label": "Integer",
          "returns": "`Value.Type` is `TyInt`, the payload is in `Value.Int`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "bulk-string",
          "label": "Bulk string",
          "returns": "`Value.Type` is `TyBulk`, the payload is in `Value.Str`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "null",
          "label": "Null",
          "returns": "`Value.Type` is `TyNull`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "array",
          "label": "Array (also nested, empty, with nulls)",
          "returns": "`Value.Type` is `TyArray`, the payload is in `Value.Array`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "map",
          "label": "Map (RESP3)",
          "returns": "`Value.Type` is `TyMap`, the payload is in `Value.Map`; on RESP2 the server sends `TyArray` instead, with the payload in `Value.Array`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "set",
          "label": "Set (RESP3)",
          "returns": "`Value.Type` is `TySet`, the payload is in `Value.Array`; on RESP2 the server sends `TyArray` instead, with the payload in `Value.Array`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "double",
          "label": "Double (RESP3)",
          "returns": "`Value.Type` is `TyDouble`, the payload is in `Value.Float`; on RESP2 the server sends `TyBulk` instead, with the payload in `Value.Str`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "boolean",
          "label": "Boolean (RESP3)",
          "returns": "`Value.Type` is `TyBool`, the payload is in `Value.Bool`; on RESP2 the server sends `TyInt` instead, with the payload in `Value.Int`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "big-number",
          "label": "Big number (RESP3)",
          "returns": "`Value.Type` is `TyBigInt`, the payload is in `Value.BigN`; on RESP2 the server sends `TyBulk` instead, with the payload in `Value.Str`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "verbatim-string",
          "label": "Verbatim string (RESP3)",
          "returns": "`Value.Type` is `TyVerbatim`, the payload is in `Value.Str`; on RESP2 the server sends `TyBulk` instead, with the payload in `Value.Str`",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        }
      ]
    },
    {
      "id": "typed-helpers",
