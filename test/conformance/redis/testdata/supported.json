            "DoBool"
          ],
          "covers": [
            "TestRESPTypedHelpers"
          ]
        },
        {
          "id": "helpers-array-of-bulk",
          "label": "Array of bulk strings",
          "works": [
            "DoSlice"
          ],
          "by_design": [
            "DoString",
            "DoInt",
            "DoBool"
          ],
          "covers": [
            "TestRESPTypedHelpers"
          ]
        },
        {
          "id": "helpers-array-of-int",
          "label": "Array of integers (an EVAL reply)",
          "works": [],
