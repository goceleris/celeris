    },
    {
      "id": "other",
      "title": "Other behaviour",
      "rows": [
        {
          "id": "large-values",
          "label": "Values up to 3 MiB, and values that contain CRLF, $, + or any byte",
          "returns": "the same bytes back",
          "works": [
            "Set",
            "SetBytes",
            "Get",
            "GetBytes",
            "Do"
          ],
          "covers": [
            "TestRESPLargeAndBinaryBulk"
          ]
        },
        {
          "id": "huge-values",
          "label": "Values of 4 MiB and more",
          "works": [],
          "fails": [
            {
              "dest": "Set",
              "gap": "R3",
              "scope": [
                "linux"
              ]
            },
            {
              "dest": "SetBytes",
              "gap": "R3",
              "scope": [
                "linux"
              ]
            }
          ],
          "covers": [
            "TestRESPLargeAndBinaryBulk"
          ]
        },
        {
          "id": "error-replies",
          "label": "Error replies",
          "returns": "a `*RedisError` whose `Prefix` is the first word (`WRONGTYPE`, `ERR`, or your script's own); the connection stays usable",
          "works": [
            "Do"
          ],
          "covers": [
            "TestRESPReplyTypes"
          ]
        },
        {
          "id": "typed-doubles",
          "label": "Commands that reply with a number with a fraction",
          "returns": "`float64`, infinities included, the same on RESP2 and RESP3",
          "works": [
            "ZScore",
            "IncrByFloat",
            "HIncrByFloat",
            "ZIncrBy"
          ],
          "covers": [
            "TestRESPTypedDoubles"
          ]
        },
        {
          "id": "typed-aggregates",
          "label": "Hashes, sets, lists and MGet",
          "returns": "`map[string]string` or `[]string`; a missing key gives an empty map or slice; fields and members may be empty or not ASCII",
          "works": [
            "HGetAll",
            "SMembers",
            "SIsMember",
            "LRange",
            "MGet"
          ],
          "covers": [
            "TestRESPTypedAggregates"
          ]
        },
        {
          "id": "push",
          "label": "Push messages on a command connection (client-side caching)",
          "returns": "delivered to the `WithOnPush` callback; the replies are not disturbed",
          "works": [
            "WithOnPush"
          ],
          "covers": [
            "TestRESPPushOnCommandConn"
          ]
        }
      ]
    }
  ],
  "gaps": [
    {
      "id": "R1",
      "release": "v1.6.0",
      "summary": "On RESP3 (the default), `DoString` and `DoInt` fail on a double, boolean or big number reply, and `DoSlice` fails on a map reply, where RESP2 returns the value.",
      "error": "celeris-redis: expected string reply, got double"
    },
    {
      "id": "R2",
      "release": "v1.6.0",
      "summary": "`DoSlice` returns an empty string for every element that is an integer, a double, a boolean or a nested array."
    },
    {
      "id": "R3",
      "release": "v1.6.0",
      "summary": "On Linux, a single value of 4 MiB or more cannot be written (`SET`, `RPUSH`, `HSET` and the other commands that carry one large argument). macOS and Windows do not have this limit.",
      "error": "celeris/engine: worker write queue full"
    }
  ]
}
